#!/bin/sh
set -e

DATA_DIR="/work/vscode"
BIND_ADDR="${1:-0.0.0.0:8080}"

log() { echo "[VSCODE] $1"; }

if [ -n "${VSCODE_TOKEN:-}" ]; then
    export PASSWORD="$VSCODE_TOKEN"
fi

if [ -n "${PASSWORD:-}" ] || [ -n "${HASHED_PASSWORD:-}" ]; then
    AUTH=password
else
    AUTH=none
fi

mkdir -p "$DATA_DIR/data" "$DATA_DIR/ext"
log "Starting code-server on $BIND_ADDR (auth=$AUTH)..."
exec /usr/lib/code-server/bin/code-server \
    --auth "$AUTH" \
    --disable-telemetry \
    --disable-update-check \
    --bind-addr "$BIND_ADDR" \
    --config "$DATA_DIR/config.yml" \
    --user-data-dir "$DATA_DIR/data" \
    --extensions-dir "$DATA_DIR/ext"
